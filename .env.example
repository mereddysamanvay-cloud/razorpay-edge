# Copy this file to ".env" and fill in your own key. NEVER commit ".env".
# Never paste the key into chat, prompts, notebooks or reports.
ANTHROPIC_API_KEY=your-key-here

# Claude model used by the agent layer (configurable; no code change needed)
CLAUDE_MODEL=claude-sonnet-5-5

# Conservative safety limits for paid calls
LLM_MAX_CALLS=130
LLM_MAX_OUTPUT_TOKENS=1500
