{
  "version": 2,
  "builds": [
    { "src": "web/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/main.py", "use": "@vercel/python", "config": { "maxLambdaSize": "250mb" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/main.py" },
    { "src": "/assets/(.*)", "dest": "/web/assets/$1" },
    { "src": "/(.*\\.(?:webp|png|svg|ico|txt|json|js|css|map|woff2?))", "dest": "/web/$1" },
    { "src": "/(.*)", "dest": "/web/index.html" }
  ]
}
